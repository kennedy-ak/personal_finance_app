# Copy to backend/.env and fill in.

# Any SQLAlchemy URL. Defaults to sqlite:///backend/finance.db when unset.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/finance

# REQUIRED before exposing the server beyond your machine.
JWT_SECRET=change-me

# The coach proxy. Leave unset to run without the AI coach.
# OPENAI_API_KEY=sk-...
# COACH_MODEL=gpt-4o-mini

# Comma-separated list, or * for any origin.
CORS_ORIGINS=*
