# The FastAPI backend (../backend). Same server as the Flutter app, so the
# same logins work. Copy to .env.local for local dev; set in Vercel for deploys.
#
# Never add OPENAI_API_KEY here: anything NEXT_PUBLIC_ ships to the browser,
# and the coach reaches OpenAI only through the backend's /coach/complete.
NEXT_PUBLIC_API_URL=http://localhost:8000
