# The FastAPI backend (backend/). From the Android emulator your machine is
# 10.0.2.2; from a real phone use your machine's LAN IP.
API_URL=http://10.0.2.2:8000

# Optional: ship a default OpenAI key with the app for the fallback transport.
# The normal path is the server coach (backend/.env OPENAI_API_KEY).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
