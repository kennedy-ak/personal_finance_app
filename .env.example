# The backend URL is NOT set here any more — it is a compile-time constant
# (lib/core/api_config.dart) that defaults to the production server:
#   https://backend.eventsexclusive.africa
# For local development pass it on the command line instead:
#   flutter run --dart-define=API_BASE_URL=http://10.0.2.2:8000
# (10.0.2.2 = your machine from the Android emulator; LAN IP for a real phone.
# Debug builds allow http cleartext; release builds are HTTPS-only.)

# Optional: ship a default OpenAI key with the app for the fallback transport.
# The normal path is the server coach (backend/.env OPENAI_API_KEY).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
